ROTOTOOLS_DATA=./data
ROTOTOOLS_MAX_BYTES=268435456
ROTOTOOLS_MAX_SECONDS=30
ROTOTOOLS_RETENTION_HOURS=24
# Download with python -m scripts.download_model; cached tiny is auto-discovered.
SAM2_MODEL_DIR=./models
# Custom checkpoint paths require an explicitly reviewed SHA-256.
SAM2_CHECKPOINT=
SAM2_SHA256=
SAM2_CONFIG=configs/sam2.1/sam2.1_hiera_t.yaml
SAM2_DEVICE=auto
SAM2_CPU_THREADS=2
